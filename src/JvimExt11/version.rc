// vi:set ts=8 sts=4 sw=4 et:
//
// VIM - Vi IMproved    jvimext11 by Sylvain Cresto
//
// Do ":help uganda"  in Vim to read copying and usage conditions.
// Do ":help credits" in Vim to see a list of people who contributed.
//
// Version information of jvimext11.dll and jvimext11_cfg.exe, included by
// their resource files after defining VI_FILETYPE, VI_DESCRIPTION and
// VI_FILENAME.  Like vim.rc, uses the version of Vim.

#include "../version.h"

VS_VERSION_INFO         VERSIONINFO
  FILEVERSION           VIM_VERSION_MAJOR,VIM_VERSION_MINOR,VIM_VERSION_PATCHLEVEL
  PRODUCTVERSION        VIM_VERSION_MAJOR,VIM_VERSION_MINOR,VIM_VERSION_PATCHLEVEL
  FILEFLAGSMASK         VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
  FILEFLAGS             VS_FF_DEBUG
#else
  FILEFLAGS             0x0L
#endif
  FILEOS                VOS__WINDOWS32
  FILETYPE              VI_FILETYPE
  FILESUBTYPE           0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    // 0x0409 == U.S. English; 0x04B0 => Unicode
    BLOCK "040904B0"
    BEGIN
        VALUE "CompanyName",            "Vim Developers\0"
        VALUE "FileDescription",        VI_DESCRIPTION "\0"
        VALUE "FileVersion",            VIM_VERSION_MAJOR_STR "." VIM_VERSION_MINOR_STR "." VIM_VERSION_PATCHLEVEL_STR "\0"
        VALUE "InternalName",           VI_FILENAME "\0"
        VALUE "LegalCopyright",         "Copyright \251 1996\0"
        VALUE "OriginalFilename",       VI_FILENAME "\0"
        VALUE "ProductName",            "Vim\0"
        VALUE "ProductVersion",         VIM_VERSION_MAJOR_STR "." VIM_VERSION_MINOR_STR "." VIM_VERSION_PATCHLEVEL_STR "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
