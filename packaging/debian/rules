#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk

%:
	dh $@

override_dh_auto_configure:
	cd src && ./configure --prefix=/usr --enable-gui=gtk4 --with-libadwaita \
		--enable-fail-if-missing --with-compiledby="Sylvain Cresto"

override_dh_auto_build:
	$(MAKE) -C src

# dh_strip keeps the debug symbols in a separate package.
override_dh_auto_install:
	$(MAKE) -j1 -C src install DESTDIR=$(CURDIR)/debian/jolivim STRIP=true

override_dh_auto_test:

override_dh_auto_clean:
